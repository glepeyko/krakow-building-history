 a z czasem zaczęły w niej przeważać klasy o profilu mechanicznym. [1] Czteroskrzydłowy budynek z wewnętrznym dziedzińcem nawiązuje do gmachu Politechniki Lwowskiej, a główne wejście mieści się w ryzalicie w formie portyku z sześcioma parami gładkich kolumn sięgających przez dwa piętra. [1] Razem z Domem Młodego Robotnika na osiedlu Stalowym gmach tworzy od strony Zalewu Nowohuckiego tzw. bramę do Nowej Huty. [1,2]","ai_sources":[{"title":"Jarosław Klaś (red.), Nowa Huta: architektoniczny portret miasta drugiej połowy XX wieku (2018), skan 63","url":"https://ruj.uj.edu.pl/server/api/core/bitstreams/007a4b1d-31a8-487b-918f-4e477f49304b/content#page=63"},{"title":"Jarosław Klaś (red.), Nowa Huta: architektoniczny portret miasta drugiej połowy XX wieku (2018), skan 33","url":"https://ruj.uj.edu.pl/server/api/core/bitstreams/007a4b1d-31a8-487b-918f-4e477f49304b/content#page=33"}],"ai_researched_at":"2026-11-26","ai_approved":true}],"numbers":{"26a":{"lat":50.077754,"lon":20.049163,"osm":"w83198161","building":"civic","district":18,"nearby":[[4850,44],[4853,57],[4852,76],[4849,99],[4854,112],[4848,129]]},"27":{"lat":50.07713,"lon":20.047539,"osm":"w83198162","name":"Zespół Placówek Opiekuńczo - Wychowawczych nr 1","entries":[5351],"district":18,"nearby":[[4847,64],[4834,65],[4852,79],[4828,89],[4848,91],[4850,97]]},"28a":{"lat":50.077265,"lon":20.049447,"osm":"w83198163","building":"garages","district":18,"nearby":[[4853,25],[4852,59],[4854,70],[4857,73],[4850,81],[4856,99]]},"25":{"lat":50.078175,"lon":20.048187,"osm":"w83198164","building":"civic","levels":"1","entries":[5349],"district":18,"nearby":[[4850,57],[4848,62],[4846,90],[4847,111],[4845,116],[4852,117]]},"26":{"lat":50.07772,"lon":20.048552,"osm":"w83198168","building":"school","levels":"3","entries":[5350],"district":18,"nearby":[[4852,63],[4853,66],[4849,67],[4848,87],[4851,99],[4854,109]]},"18":{"lat":50.080152,"lon":20.047645,"osm":"w107196654","building":"school","levels":"4","entries":[5342],"district":