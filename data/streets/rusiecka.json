ielowie musieli opuścić Ruszczę, a majątek przejęto na cele reformy rolnej; w budynku działały potem spółdzielnia rolnicza, sklep i poczta. [1] Opuszczony dwór niszczał, a w czerwcu 2011 r. rozpoczęto remont dachu. [1]","ai_sources":[{"title":"Dwór Popielów w Ruszczy – Wikipedia","url":"https://pl.wikipedia.org/wiki/Dw%C3%B3r_Popiel%C3%B3w_w_Ruszczy"}],"ai_researched_at":"2026-11-20","ai_approved":true},{"id":4438,"street":"Rusiecka","street_search":"rusiecka","building_number":"8","address_raw":"ul. Rusiecka 8","district_number":18,"district_name":"Nowa Huta","type_and_name":"dom","dating":"1912","source":"Gminna Ewidencja Zabytków Miasta Krakowa","status":"verified","lat":50.086739,"lon":20.146584,"osm":"n2766040012"}],"numbers":{"4":{"lat":50.086131,"lon":20.145233,"osm":"w337950966","district":18,"nearby":[[3992,118]]},"2a":{"lat":50.084332,"lon":20.145475,"osm":"w337952093","district":18,"nearby":[[8082,161],[3992,278],[1681,382]]},"1":{"lat":50.086622,"lon":20.144772,"osm":"n2765964289","district":18,"nearby":[[3992,130],[1681,148]]},"13":{"lat":50.087981,"lon":20.14818,"osm":"n2765967931","entries":[4437],"district":18,"nearby":[[1681,170],[1683,175],[3992,178]]},"14":{"lat":50.087002,"lon":20.148392,"osm":"n2765969329","district":18,"nearby":[[3991,109],[3992,132]]},"15b":{"lat":50.08792,"lon":20.150752,"osm":"n2765970100","district":18,"nearby":[[3991,184],[3992,325],[1681,352]]},"15a":{"lat":50.087824,"lon":20.150182,"osm":"n2765970763","district":18,"nearby":[[3991,144]]},"17":{"lat":50.087466,"lon":20.151043,"osm":"n2765974966","district":18,"nearby":[[3991,212],[3992,328],[1681,374]]},"19":{"lat":50.087063,"lon":20.149663,"osm":"n2765978935","district":18,"nearby":[[3991,147]]},"19a":{"lat":50.087404,"lon":20.149861,"osm":"n2765980142","district":18,"nearby":[[3991,136]]},"2":{"lat":50.086507,"lon":20.145111,"osm":"n2765983995","district":18,"nearby":[[3992,108],[1681,149]]},"21":{"lat":50.087089,"lon":20.149829,"osm":"n2765987701","district":18,"nearby