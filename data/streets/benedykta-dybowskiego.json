{"name":"Benedykta Dybowskiego","search":"benedykta dybowskiego","story":{"districts":[18]},"districts":{"18":"Nowa Huta"},"entries":[{"id":1265,"street":"Benedykta Dybowskiego","street_search":"benedykta dybowskiego","building_number":"2","address_raw":"ul. Dybowskiego Benedykta 2","district_number":18,"district_name":"Nowa Huta","type_and_name":"zespół pałacowo - parkowy w Kościelnikach: pałac, dwie oficyny i park","dating":"1708","author":"Józef Piola","register_number":"A-676, 3.VI.1985","source":"Gminna Ewidencja Zabytków Miasta Krakowa","status":"ai_draft_unverified","lat":50.095853,"lon":20.17904,"osm":"w236090759","wikidata":"Q11814885","wikipedia":"https://pl.wikipedia.org/wiki/Pa%C5%82ac_Wodzickich_w_Ko%C5%9Bcielnikach","image":"Koscielniki Wodzicki palace south.jpg","name":"Pałac Wodzickich w Kościelnikach","styles":["klasycyzm"],"wd_description":"zabytkowy pałac w Krakowie","nid_name":"zespół pałacowo-parkowy","nid_register":"I-3-1/47 z 1947-01-31, I-4-5/47 z 1947-01-31, I-3-1/47 z 1947-03-31, A-676 z 1985-06-03","nid_register_date":"1985-06-03","nid_chronology":"pocz. XVIII w.","nid_url":"https://zabytek.pl/pl/obiekty/zabytek?inspire_id=PL.1.9.ZIPOZ.NID_N_12_ZE.58471&rejestr=rejestr-zabytkow","nid_inspire_id":"PL.1.9.ZIPOZ.NID_N_12_ZE.58471","photo":{"thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/Koscielniki_Wodzicki_palace_south.jpg/960px-Koscielniki_Wodzicki_palace_south.jpg","width":800,"height":633,"author":"Adrian Tync","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","page":"https://commons.wikimedia.org/wiki/File:Koscielniki_Wodzicki_palace_south.jpg"},"ai_description":"W 1708 r. Stefan Morstin zlecił budowę pałacu – piętrowej barokowej budowli pośrodku dawnego założenia obronnego, według projektu Józefa Pioli. [1] Od 1773 r. do końca II wojny światowej majątek należał do Wodzickich, a pod koniec XVIII w. Eliasz Wodzicki przebudował pałac w duchu klasycyzmu. [1] Gościł tu król Stanisław August Poniatowski, który spotkał się z siostrą Izabellą; wizytę upamiętniła fontanna z inskrypcjami ufundowana przez Eliasza Wodzickiego; w pałacu uczył też muzyki Franciszek Ksawery Matejko, ojciec malarza. [1] Po upadku Powstania Warszawskiego Wodziccy urządzili tu szpital dla uchodźców; w styczniu 1945 r. opuścili majątek, a stacjonujący potem w pałacu żołnierze Armii Czerwonej zniszczyli resztę wyposażenia i wycięli drzewa w parku. [1] W 1998 r. pałac wrócił do rodziny, a w 2020 r. sprzedano go prywatnemu nabywcy. [1]","ai_sources":[{"title":"Pałac Wodzickich w Kościelnikach – Wikipedia","url":"https://pl.wikipedia.org/wiki/Pa%C5%82ac_Wodzickich_w_Ko%C5%9Bcielnikach"}],"ai_researched_at":"2026-11-20"}],"numbers":{"2":{"lat":50.095853,"lon":20.17904,"osm":"w236090759","start_date":"1708","name":"Pałac Wodzickich w Kościelnikach","entries":[1265],"district":18,"nearby":[[8297,46],[6470,64],[8457,82],[8458,84]]},"1":{"lat":50.096688,"lon":20.180958,"osm":"w337950281","building":"house","levels":"2","district":18,"nearby":[[8458,84],[3837,129],[8297,134]]},"2b":{"lat":50.095786,"lon":20.181986,"osm":"w337950339","building":"presbytery","levels":"2","name":"Plebania","district":18,"nearby":[[3837,91]]},"5":{"lat":50.096819,"lon":20.18804,"osm":"w337952095","building":"detached","levels":"1","district":18,"nearby":[[3837,382],[8458,585]]},"1b":{"lat":50.096789,"lon":20.179661,"osm":"w720551528","building":"house","levels":"2","district":18,"nearby":[[8458,47],[8457,106],[8297,109],[1100,113],[6470,146]]},"1d":{"lat":50.096785,"lon":20.18189,"osm":"w720877306","building":"house","levels":"2","district":18,"nearby":[[3837,70]]},"1a":{"lat":50.096813,"lon":20.180112,"osm":"w1341633079","building":"construction","district":18,"nearby":[[8458,50],[8297,116],[1100,131],[8457,137]]},"6j":{"lat":50.095928,"lon":20.186833,"osm":"w1364971691","building":"residential","district":18,"nearby":[[3837,299],[8458,499],[6291,511]]},"9":{"lat":50.096783,"lon":20.188883,"osm":"w136497169